{
  "name": "bao-bundler",
  "version": "0.3.0",
  "description": "Bao Bundler is a simple, code-driven, and manifest-aware asset bundler for web projects, built with Bun.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./flows": {
      "import": "./dist/flows.js",
      "types": "./dist/flows.d.ts"
    },
    "./runners": {
      "import": "./dist/runners.js",
      "types": "./dist/runners.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "docs": "typedoc",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typedoc": "^0.28.17",
    "sass": "^1.105.2",
    "sharp": "^0.35.5",
    "handlebars": "^4.7.10",
    "ejs": "^7.0.1",
    "mustache": "^4.2.0",
    "html-minifier-terser": "^7.2.0"
  },
  "peerDependencies": {
    "typescript": "^5",
    "sass": "^1.105.2",
    "sharp": "^0.35.5",
    "handlebars": "^4.7.10",
    "ejs": "^7.0.1",
    "mustache": "^4.2.0",
    "html-minifier-terser": "^7.2.0"
  },
  "keywords": [
    "bun",
    "bundler",
    "assets"
  ],
  "license": "MIT",
  "peerDependenciesMeta": {
    "sass": {
      "optional": true
    },
    "sharp": {
      "optional": true
    },
    "handlebars": {
      "optional": true
    },
    "ejs": {
      "optional": true
    },
    "mustache": {
      "optional": true
    },
    "html-minifier-terser": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
